# ============================================================
# FUNÇÕES DO CATÁLOGO
# ============================================================

def listar_apis():
    return APIS


def buscar_api_por_id(api_id):

    for api in APIS:

        if api["id"] == api_id:
            return api

    return None


def buscar_por_segmento(segmento):

    segmento = str(segmento).lower()

    return [
        api for api in APIS
        if segmento in api["segmento"].lower()
    ]


def contar_apis():

    return len(APIS)


def listar_segmentos():

    return sorted(set(
        api["segmento"]
        for api in APIS
    ))


def resumo_catalogo():

    return {
        "total_apis": len(APIS),

        "segmentos": len(listar_segmentos()),

        "consultas_testadas": sum(
            1 for api in APIS
            if api["status"] == "Consulta testada no projeto"
        ),

        "pendentes_de_validacao": sum(
            1 for api in APIS
            if "pendente" in api["status"].lower()
        )
    }
